<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Покупка билета</title>
    <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
</head>
<body>
    <div class="main-content" style="display: flex; gap: 32px;">
        <div>
            <div><strong>Зал:</strong> {{ hallNumber }}</div>
            <div style="margin-top: 10px;"><strong>Мест:</strong> {{ placesCount }}</div>
        </div>
        <div style="background: #374151; border-radius: 8px; padding: 16px; min-width: 220px;">
            <div style="font-weight: bold; color: #facc15;">{{ performance.performanceTitle }}</div>
            <div>Жанр: {{ performance.performanceGenre }}</div>
            <div>Длительность: {{ performance.performanceDuration|date('H:i') }}</div>
            <div>Цена: {{ performance.performancePrice }} руб.</div>
        </div>
        <a href="/">Вернуться на главную</a>
        <div class="hall-scheme" style="margin-top: 30px;">
            <h3>Схема зала</h3>
            <div style="display: flex; flex-wrap: wrap; max-width: 400px;">
                {% set priceMap = {'Партер': 300, 'Амфитеатр': 500, 'Ложа': 400} %}
                {% for i in 1..placesCount %}
                    {% set place = (places|filter(p => p.placeNumber == i)|first) %}
                    {% set isTaken = i in takenPlaces %}
                    {% set status = place ? place.placeStatus : 'Неизвестно' %}
                    {% set level = place ? place.placeLevel : 'Неизвестно' %}
                    {% set levelName = level == 1 ? 'Партер' : (level == 2 ? 'Амфитеатр' : (level == 3 ? 'Ложа' : 'Неизвестно')) %}
                    {% set price = priceMap[levelName]|default('—') %}
                    <button type="button"
                        class="place-btn"
                        style="
                            width: 32px; height: 32px; margin: 4px; display: flex; align-items: center; justify-content: center;
                            border: 1px solid #888;
                            background: {{ isTaken ? '#e11d48' : '#facc15' }};
                            color: #222;
                            border-radius: 4px;
                            font-weight: bold;
                            position: relative;
                            cursor: pointer;
                        "
                        data-status="{{ status }}"
                        data-level="{{ levelName }}"
                        data-price="{{ price }}"
                    >
                        {{ i }}
                        <span class="place-tooltip" style="
                            display:none;
                            position: absolute;
                            bottom: 110%;
                            left: 50%;
                            transform: translateX(-50%);
                            background: #374151;
                            color: #fff;
                            padding: 6px 12px;
                            border-radius: 6px;
                            font-size: 0.95rem;
                            white-space: nowrap;
                            z-index: 10;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
                        "></span>
                    </button>
                {% endfor %}
            </div>
            <div style="margin-top: 10px;">
                <span style="display:inline-block;width:20px;height:20px;background:#e11d48;border-radius:3px;margin-right:5px;vertical-align:middle;"></span> Занято
                <span style="display:inline-block;width:20px;height:20px;background:#facc15;border-radius:3px;margin-left:15px;margin-right:5px;vertical-align:middle;"></span> Свободно
            </div>
        </div>
    </div>
    <script src="{{ asset('script/sidebar.js') }}"></script></body>
</body>
</html>