<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Изменить репертуары</title>
    <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
    <style>
        input[type="text"],
        input[type="number"],
        select,
        textarea {
            font-size: 1.2em;
            padding: 0.2em 1em;
        }
        button.btn {
            font-size: 1.3em;
            padding: 0.2em 1.5em;
        }
        input[disabled], select[disabled] {
            color: #fff !important;
            background: #444 !important;
            opacity: 1 !important;
        }
        select[disabled] {
            color: #fff !important;
            background: #444 !important;
            opacity: 1 !important;
            width: 100% !important;
            appearance: auto !important;
        }
    </style>
</head>
<body>
    <nav class="nav-sidebar" id="sidebar">
        <div class="sidebar-header">
            <h2 class="nav-logo">SocialTheater</h2>
            <button class="sidebar-toggle" id="sidebar-toggle">☰</button>
        </div>
        <ul class="nav-list">
            <li><a href="{{ path('app_home') }}" class="nav-link">Главная</a></li>
            <li><a href="{{ path('app_about') }}" class="nav-link">О театре</a></li>
            <li><a href="{{ path('app_logout') }}" class="nav-link">Выйти</a></li>
            <li><a href="{{ path('app_profile') }}" class="nav-link">Личный кабинет</a></li>
        </ul>
    </nav>

    <div class="content-wrapper" id="content-wrapper">
        <div class="main-content">
            <h1>Редактирование репертуаров</h1>
            {% if error %}
                <div class="error">{{ error }}</div>
            {% endif %}
            <form method="post">
                <table>
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Размер</th>
                            <th>Администратор</th>
                            <th>Менеджер</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rep in repertoires %}
                            <tr>
                                <td>
                                    <input type="text" name="repertoires[{{ rep.repertoireId }}][title]" value="{{ rep.repertoireTitle }}" required>
                                </td>
                                <td>
                                    <input type="number" name="repertoires[{{ rep.repertoireId }}][size]" value="{{ rep.repertoireSize }}" required>
                                </td>
                                <td>
                                    <input type="text" value="{{ rep.administrator.administratorFullname }}" disabled>
                                    <input type="hidden" name="repertoires[{{ rep.repertoireId }}][administrator]" value="{{ rep.administrator.administratorId }}">
                                </td>
                                <td>
                                    <select name="repertoires[{{ rep.repertoireId }}][manager]">
                                        <option value="">Менеджер</option>
                                        {% for manager in admin_managers %}
                                            <option value="{{ manager.managerId }}"
                                                {% if rep.manager and rep.manager.managerId == manager.managerId %}selected{% endif %}>
                                                {{ manager.managerFullname }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <input type="hidden" name="new_administrator" value="{{ currentAdminId }}">                                
                                </td>
                            </tr>
                        {% endfor %}
                        {% set currentAdmin = null %}
                        {% for admin in administrators %}
                            {% if admin.administratorId == currentAdminId %}
                                {% set currentAdmin = admin %}
                            {% endif %}
                        {% endfor %}

                        <tr>
                            <td><input type="text" name="new_title" placeholder="Новое название"></td>
                            <td><input type="number" name="new_size" placeholder="Размер"></td>
                            <td>
                                <input type="hidden" name="new_administrator" value="{{ currentAdminId }}">
                                {{ currentAdmin ? currentAdmin.administratorFullname : '' }}
                            </td>
                            <td>
                                <select name="new_manager">
                                    <option value="">Менеджер</option>
                                    {% for manager in admin_managers %}
                                        <option value="{{ manager.managerId }}">{{ manager.managerFullname }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <button type="submit" class="btn">Сохранить изменения</button>
            </form>
        </div>
    </div>
</body>
</html>