<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SocialTheater - Личный кабинет</title>
    <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
</head>
<body>
    <nav class="nav-sidebar" id="sidebar">
        <div class="sidebar-header">
            <h2 class="nav-logo">SocialTheater</h2>
            <button class="sidebar-toggle" id="sidebar-toggle">☰</button>
        </div>
        <ul class="nav-list">
            <li><a href="{{ path('app_home') }}" class="nav-link">Главная</a></li>
            <li><a href="{{ path('app_about') }}" class="nav-link">О театре</a></li>
            <li><a href="{{ path('app_logout') }}" class="nav-link">Выйти</a></li>
        </ul>
    </nav>

    <div class="content-wrapper" id="content-wrapper">
        <div class="mobile-nav">
            <a href="{{ path('app_home') }}" class="mobile-nav-link">Главная</a>
            <a href="{{ path('app_about') }}" class="mobile-nav-link">О театре</a>
            <a href="{{ path('app_logout') }}" class="mobile-nav-link">Выйти</a>
        </div>

        <div class="main-content">
            <h1>Личный кабинет</h1>
            <div class="profile-info">
                <p><strong>ФИО:</strong> {{ user.fullname }}</p>
                <p><strong>Email:</strong> {{ user.email }}</p>
                <p><strong>Роль:</strong> {{ user.role == 'viewer' ? 'Пользователь' : user.role == 'manager' ? 'Менеджер' : 'Администратор' }}</p>
            </div>
            {% if user.role == 'viewer' and tickets is not empty %}
                <h3>Купленные билеты</h3>
                <table border="1" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                    <thead>
                        <tr>
                            <th>Дата покупки</th>
                            <th>Дата спектакля</th>
                            <th>Название</th>
                            <th>Продолжительность</th>
                            <th>Номер зала</th>
                            <th>Номер места</th>
                            <th>Цена</th>
                            <th>Код билета</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ticket in tickets %}
                            <tr>
                                <td>{{ ticket.ticketPurchaseDate|date('Y-m-d') }}</td>
                                <td>{{ ticket.performance.performanceData|date('Y-m-d') }}</td>
                                <td>{{ ticket.performance.performanceTitle }}</td>
                                <td>{{ ticket.performance.performanceDuration|date('H:i') }}</td>
                                <td>{{ ticket.hall.hallId }}</td>
                                <td>{{ ticket.place.placeNumber }}</td>
                                <td>{{ ticket.price }} руб.</td>
                                <td>{{ ticket.ticketCode }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
            {% if user.role == 'manager' %}
                <div class="manager-actions">
                    <a href="{{ path('app_performances') }}" class="filter-button">Изменить репертуар</a>
                </div>
            {% endif %}

            <p><hr class="admin-divider"></p>
            
            {% if user.role == 'manager' and commands is not empty %}
                <div class="manager-commands-wrapper">
                    <div class="manager-commands-section">
                        <h3>Указания от администратора</h3>
                        <table class="manager-commands-table">
                            <tr>
                                <th>Сообщение</th>
                                <th>Действие</th>
                            </tr>
                            {% for command in commands %}
                                <tr>
                                    <td>{{ command.commandContent }}</td>
                                    <td>
                                        <form method="post" action="{{ path('command_delete', {'id': command.commandId}) }}" style="display:inline;">
                                            <button type="submit" class="btn" onclick="return confirm('Вы уверены, что выполнили указание?');">Выполнено</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </div>
                </div>
            {% endif %}
            {% if user.role == 'admin' %}
                <div class="admin-stats-section admin-section">
                    <h3>Аналитика спектаклей и продаж</h3>
                    <form method="get" action="{{ path('app_profile') }}" class="admin-stats-form">
                        <div class="admin-stats-row">
                            <span>10 наименее доходных спектаклей за</span>
                            <select name="least_period">
                                <option value="month" {% if least_period == 'month' %}selected{% endif %}>Месяц</option>
                                <option value="halfyear" {% if least_period == 'halfyear' %}selected{% endif %}>Полгода</option>
                            </select>
                            <button type="submit" name="action" value="least" class="btn filter-button">Показать</button>
                        </div>
                        <div class="admin-stats-row">
                            <span>Общий доход со спектаклей по жанру</span>
                            <select name="genre">
                                <option value="all" {% if genre == 'all' %}selected{% endif %}>Все жанры</option>
                                {% for g in genres %}
                                    <option value="{{ g }}" {% if genre == g %}selected{% endif %}>{{ g }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" name="action" value="genre" class="btn filter-button">Показать</button>
                        </div>
                        <div class="admin-stats-row">
                            <span>Продажи билетов для зала</span>
                            <select name="hall">
                                <option value="all" {% if hall == 'all' %}selected{% endif %}>Все залы</option>
                                {% for h in halls %}
                                    <option value="{{ h.hallId }}" {% if hall == h.hallId %}selected{% endif %}>Зал №{{ h.hallId }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" name="action" value="hall" class="btn filter-button">Показать</button>
                        </div>
                    </form>
                    {# Здесь можно выводить результаты аналитики, если они есть #}
                    {% if least_performances is defined %}
                        <div class="admin-stats-result">
                            <strong>10 наименее доходных спектаклей:</strong>
                            <ul>
                                {% for perf in least_performances %}
                                    <li>{{ perf.performanceTitle }} — {{ perf.income }} руб.</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                    {% if genre_income is defined %}
                        <div class="admin-stats-result">
                            <strong>Общий доход по жанру:</strong> {{ genre_income }} руб.
                        </div>
                    {% endif %}
                    {% if hall_sales is defined %}
                        <div class="admin-stats-result">
                            <strong>Продажи билетов для выбранного зала:</strong> {{ hall_sales }} билетов
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            <hr class="admin-divider">

            {% if user.role == 'admin' %}
                <div class="admin-actions">
                    <a href="{{ path('app_change_repertoire') }}" class="btn filter-button">Добавить репертуар</a> 
                </div>
                <div class="admin-section">
                    <h3>Отправленные указания менеджерам</h3>
                    <table style="width:100%;margin-bottom:20px;">
                        <thead>
                            <tr>
                                <th>Менеджер</th>
                                <th>Сообщение</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for command in admin_commands %}
                                <tr>
                                    <td>{{ command.manager.managerFullname }}</td>
                                    <td>{{ command.commandContent }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="2">Нет отправленных указаний.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <hr class="admin-divider">

                <div class="admin-section">
                    <h3>Добавить новое указание менеджеру</h3>
                    <form method="post" action="{{ path('command_add') }}">
                        <textarea name="command_content" placeholder="Текст указания" required style="width:100%;margin-bottom:10px;"></textarea>
                        <select name="manager_id" required style="width:100%;margin-bottom:10px;">
                            <option value="">Выберите менеджера</option>
                            {% for manager in admin_managers %}
                                <option value="{{ manager.managerId }}">{{ manager.managerFullname }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="btn">Отправить указание</button>
                    </form>
                </div>
            {% endif %}
            <div class="profile-actions">
                <a href="{{ path('app_home') }}" class="filter-button">Вернуться</a>
                <a href="{{ path('app_logout') }}" class="filter-button">Выйти</a>
            </div>
        </div>

        <div class="footer">
            <p>Контакты: телефон администратора: 89046862432</p>
            <p>Почта администратора: egorbezrukavnikov@gmail.com</p>
            <p>vk: <a href="https://vk.com/id488943174">https://vk.com/id488943174</a></p>
        </div>
    </div>

    <script src="{{ asset('scripts/sidebar.js') }}"></script>
</body>
</html>
