# Symfony environment files
/.env.local
/.env.local.php
/.env.*.local

# Symfony cache, logs, sessions
/var/
/var/*
!/var/.gitkeep

# Vendor (composer dependencies)
/vendor/

# Public bundles (assets from vendors)
/public/bundles/
/public/assets/
/assets/vendor/

# PHPUnit
/phpunit.xml
.phpunit.result.cache

# Symfony secrets
/config/secrets/prod/prod.decrypt.private.php

# IDE files
/.idea/
/*.iml
/.vscode/

# OS files
.DS_Store
Thumbs.db

# Node/npm (if using Encore or npm)
/node_modules/
/yarn.lock
/package-lock.json

# Build artifacts
/build/
dist/